// Eleman eleman işlemler: 4096x4096 float. Aynı çağrı 0 turla (yalnızca
// GPU'ya/geri kopyalama) ve 20 turla ölçülür; fark tur başına GPU süresidir.
// Tur başına 3 x 64 MB bellek trafiği (x ve b okunur, x yazılır).

@GPU
func adimlar(matrix<float> a, matrix<float> b, int n) -> matrix<float> {
    matrix<float> x = a;
    for k in 0 .. n {
        x = x * 0.5 + b;
    }
    return x;
}

func main() -> void {
    matrix<float> a = fill(4096, 4096, 1.0);
    matrix<float> b = fill(4096, 4096, 0.25);
    matrix<float> isinma = adimlar(a, b, 1);
    float64 t0 = time();
    matrix<float> y = adimlar(a, b, 0);
    float64 t1 = time();
    matrix<float> x = adimlar(a, b, 20);
    float64 t2 = time();
    print("eleman_tur_ms", ((t2 - t1) - (t1 - t0)) * 1000.0 / 20.0);
    print("sagla", x[17, 33], isinma[0, 0], y[1, 1]);
    print("kopyalama_ms", (t1 - t0) * 1000.0);
}
