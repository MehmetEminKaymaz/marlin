{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Marlin",
  "scopeName": "source.marlin",
  "fileTypes": ["marl"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#annotations" },
    { "include": "#imports" },
    { "include": "#function-declaration" },
    { "include": "#struct-declaration" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#builtins" },
    { "include": "#function-call" },
    { "include": "#type-names" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.marlin",
          "begin": "/\\*",
          "end": "\\*/",
          "captures": { "0": { "name": "punctuation.definition.comment.marlin" } }
        },
        {
          "name": "comment.line.double-slash.marlin",
          "begin": "//",
          "end": "$",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.marlin" } }
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.marlin",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.marlin" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.marlin" } },
      "patterns": [
        { "name": "constant.character.escape.marlin", "match": "\\\\." }
      ]
    },
    "chars": {
      "name": "string.quoted.single.marlin",
      "match": "'(\\\\.|[^'\\\\])'",
      "captures": { "1": { "patterns": [ { "name": "constant.character.escape.marlin", "match": "\\\\." } ] } }
    },
    "annotations": {
      "comment": "@GPU, @CPU (fonksiyonun hedefi), @pure (yan etkisiz extern)",
      "match": "(@)(GPU|CPU|pure|[A-Za-z_][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": { "name": "punctuation.definition.annotation.marlin" },
        "2": { "name": "storage.modifier.annotation.marlin" }
      }
    },
    "imports": {
      "patterns": [
        {
          "comment": "import a.b as v;   from a.b import f, g as h;",
          "match": "\\b(import|from)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": { "name": "keyword.control.import.marlin" },
            "2": { "name": "entity.name.namespace.marlin" }
          }
        },
        {
          "match": "\\b(as)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.import.marlin" },
            "2": { "name": "entity.name.namespace.marlin" }
          }
        }
      ]
    },
    "function-declaration": {
      "match": "\\b(func)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.function.marlin" },
        "2": { "name": "entity.name.function.marlin" }
      }
    },
    "struct-declaration": {
      "match": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.struct.marlin" },
        "2": { "name": "entity.name.type.struct.marlin" }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.marlin",
          "match": "\\b(if|else|while|for|in|step|break|continue|return)\\b"
        },
        {
          "comment": "Paralellik ve görevler",
          "name": "keyword.control.concurrency.marlin",
          "match": "\\b(parallel|marl)\\b"
        },
        {
          "name": "storage.modifier.marlin",
          "match": "\\b(public|private|extern)\\b"
        },
        {
          "name": "storage.type.marlin",
          "match": "\\b(func|struct|let)\\b"
        }
      ]
    },
    "types": {
      "name": "storage.type.primitive.marlin",
      "match": "\\b(int8|int16|int64|int|uint8|uint16|uint64|uint|float64|float|bool|char|string|void|list|matrix|task)\\b"
    },
    "constants": {
      "name": "constant.language.boolean.marlin",
      "match": "\\b(true|false)\\b"
    },
    "builtins": {
      "comment": "Yerleşik fonksiyonlar (AST/Builtins.h)",
      "match": "\\b(print|time|sqrt|sin|cos|tan|atan|tanh|exp|log|log2|log10|floor|ceil|round|trunc|pow|atan2|abs|min|max|push|pop|len|free|str|to_int|to_float|zeros|ones|fill|shape|rows|cols|matmul|transpose|sum|await|scan)\\s*(?=\\()",
      "captures": { "1": { "name": "support.function.builtin.marlin" } }
    },
    "function-call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.call.marlin" } }
    },
    "type-names": {
      "comment": "Büyük harfle başlayan isimler struct tipleridir (adlandırma geleneği)",
      "name": "entity.name.type.marlin",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "numbers": {
      "name": "constant.numeric.marlin",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.marlin", "match": "->" },
        { "name": "keyword.operator.range.marlin", "match": "\\.\\." },
        { "name": "keyword.operator.logical.marlin", "match": "&&|\\|\\||!(?!=)" },
        { "name": "keyword.operator.comparison.marlin", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.assignment.marlin", "match": "=" },
        { "name": "keyword.operator.arithmetic.marlin", "match": "[+\\-*/%]" },
        { "name": "keyword.operator.lambda.marlin", "match": "\\|" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.terminator.statement.marlin", "match": ";" },
        { "name": "punctuation.separator.comma.marlin", "match": "," },
        { "name": "punctuation.accessor.marlin", "match": "\\." }
      ]
    }
  }
}
