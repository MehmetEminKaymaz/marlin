// std.db — veritabanı sürücülerinin (std.postgres, std.sqlite) ortak parçası.
//
// Bir sorgunun sonucu, satırlarını okumak için bir satır kaynağı (Rows) verir.
// Yerleşik `scan`, satırları adları sütun adlarıyla aynı olan struct alanlarına
// doldurur; doldurulacak tip bağlamdan anlaşılır:
//
//   struct Kullanici {
//       int64 id;
//       string ad;
//       int yas;
//   }
//
//   list<Kullanici> hepsi = scan(r.rows);   // bütün satırlar
//   Kullanici ilk = scan(r.rows);           // ilk satır (sonuç boşsa program durur)
//
// Kurallar:
//
//   * Her alan için sonuçta aynı adda bir sütun olmalı (yoksa program durur);
//     fazla sütunlar yok sayılır. Sütun adı sorguda `AS` ile verilebilir.
//   * Alan tipleri: tamsayılar, float / float64, bool ve string. Değerin metni
//     alan tipine çevrilir; çevrilemezse program durur (ör. "abc" → int).
//   * NULL değer alanın sıfır değeri olur: 0, false, "". Ayırt etmek gerekiyorsa
//     sürücünün is_null fonksiyonu kullanılır.
//
// Kendi satır kaynağını yazmak da mümkündür (ör. bellekteki bir tablo): Rows'un
// fonksiyonları satır / sütun numarasıyla değerin metnini vermelidir.

public struct Rows {
    int64 handle;                              // sürücünün sonuç nesnesi
    (int64) -> int64 count;                    // satır sayısı
    (int64, string) -> int64 column;           // adı verilen sütunun sırası; yoksa -1
    (int64, int64, int64) -> string text;      // (satır, sütun) değerinin metni
    (int64, int64, int64) -> bool is_null;     // (satır, sütun) değeri NULL mı?
}
