// expect: 214
// Döngü ve if içinden return.
func bul(int[5] a, int x) -> int {
    for i in 0 .. 5 {
        if a[i] == x { return i; }
    }
    return -1;
}

// Bütün dallar return ediyor: if'ten sonra erişilebilir kod kalmaz.
func isaret(int x) -> int {
    if x > 0 { return 1; } else if x < 0 { return -1; } else { return 0; }
}

func ilkBuyuk(int[5] a, int esik) -> int {
    for v in a {
        if v > esik { return v; }
    }
    return 0;
}

func main() -> int {
    int[5] d = [4, 8, 15, 16, 23];
    // 2*100 + (-1) + (-1) + 1 + 0 + 15
    return bul(d, 15) * 100 + bul(d, 7) + isaret(-9) + isaret(3) + isaret(0) + ilkBuyuk(d, 10);
}
