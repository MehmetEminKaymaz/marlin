// output: c 3
// output: 6
// output: 6 30
// list<T>: büyüyebilen, başvuru olarak dolaşan liste.

func topla(list<int> veri) -> int {
    int t = 0;
    for x in veri { t = t + x; }
    return t;
}

// Parametre başvurudur: çağıranın listesi değişir.
func ikiyeKatla(list<int> veri) -> void {
    for i in 0 .. len(veri) { veri[i] = veri[i] * 2; }
}

// Liste döndürme: yığın belleğinde yaşadığı için fonksiyondan sonra da geçerli.
func uret(int n) -> list<int> {
    list<int> l = [];
    for i in 0 .. n { push(l, i); }
    return l;
}

func bos() -> list<float64> {
    return [];
}

func main() -> void {
    list<int> l = [1, 2, 3];
    print(len(l), l[0], l[2]);

    push(l, 10);
    print(len(l), l[3]);

    int son = pop(l);
    print(son, len(l), l[1]);

    list<int> yeni;                           // başlangıç değeri yoksa boş liste
    print(len(yeni));

    list<float64> f = bos();
    push(f, 2);                               // tamsayı, eleman tipine çevrilir
    push(f, 5.5);
    f[0] = 5;
    print(f[0], f[0] + f[1] - 3);

    for x in l { print(x); }

    // Büyüme: kapasite defalarca ikiye katlanır
    list<int> buyuk = uret(1000);
    print(len(buyuk), buyuk[0], buyuk[999], topla(buyuk));

    // Başvuru: a ve b aynı listedir, büyüdükten sonra bile
    list<int> a = [1, 2, 3];
    list<int> b = a;
    b[0] = 99;
    push(b, 4);
    print(a[0], b[0], len(a));

    // Yeniden atama: a artık başka bir listeyi gösterir, b eskisini
    a = [5, 6, 7, 8, 9];
    print(len(a), len(b));

    ikiyeKatla(a);
    print(a[0], a[4], len(a));

    // Boşalana kadar pop
    int t = 0;
    while len(b) > 0 { t = t + pop(b); }
    print(t, len(b));

    // Liste üzerinde break'li döngü (cf yolu)
    int ilk = -1;
    for x in buyuk {
        if x > 500 { ilk = x; break; }
    }
    print(ilk);

    // len dizilerde ve stringlerde de çalışır
    int[3] d = [1, 2, 3];
    print(len(d), len("merhaba"));

    list<char> harfler = ['a', 'b'];
    push(harfler, 'c');
    print(harfler[2], len(harfler));

    print(topla([1, 2, 3]));                  // literal doğrudan argüman

    // pop sonrası yeniden büyüme
    for i in 1 .. 6 { push(yeni, i); }        // [1,2,3,4,5]
    pop(yeni);
    pop(yeni);                                // [1,2,3]
    push(yeni, 7);
    push(yeni, 8);
    push(yeni, 9);                            // [1,2,3,7,8,9]
    print(len(yeni), topla(yeni));

    free(buyuk);
    free(a);
}
