// send: GET / HTTP/1.1\nHost: a\n\n
// reply: HTTP/1.1 200 OK
// reply: Content-Type: text/plain; charset=utf-8
// reply: Content-Length: 4
// reply: Connection: keep-alive
// reply:
// reply: kok
// send: GET /selam HTTP/1.0\r\n\r\n
// reply: HTTP/1.1 200 OK
// reply: Content-Type: text/plain; charset=utf-8
// reply: Content-Length: 10
// reply: Connection: close
// reply:
// reply: merhaba !

import std.http as http;

func kok(http.Request req) -> http.Response {
    return http.text(200, "kok\n");
}

func selam(http.Request req) -> http.Response {
    return http.text(200, "merhaba " + http.query_param(req, "ad") + "!\n");
}

func yanki(http.Request req) -> http.Response {
    http.Response res = http.json(201, "{\"uzunluk\": " + str(len(req.body)) +
                                       ", \"govde\": \"" + req.body + "\"}");
    http.add_header(res, "X-Yontem", req.method);
    return res;
}

func dosya(http.Request req) -> http.Response {
    return http.text(200, "dosya: " + http.url_decode(req.path) + "\n");
}

func bos(http.Request req) -> http.Response {
    list<http.Header> headers = [];
    return http.Response(204, headers, "");
}

func baslik(http.Request req) -> http.Response {
    return http.text(200, http.header(req, "x-ozel") + "\n");
}

func main() -> void {
    list<http.Route> rotalar = [];
    push(rotalar, http.get("/", kok));
    push(rotalar, http.get("/selam", selam));
    push(rotalar, http.post("/yanki", yanki));
    push(rotalar, http.get("/dosyalar/*", dosya));
    push(rotalar, http.get("/bos", bos));
    push(rotalar, http.route("", "/baslik", baslik));

    http.Server s = http.listen(18471);
    if !s.ok {
        print(s.error);
        return;
    }
    print("hazir");
    for i in 0 .. 11 {
        http.handle(s, rotalar);
    }
    http.close(s);
    free(rotalar);
    print("bitti");
}
