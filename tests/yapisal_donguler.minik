// expect: 151
// Dışarı atlamayan döngüler: hepsi scf.for / scf.while olarak üretilmeli.
func main() -> int {
    int toplam = 0;
    for i in 0 .. 5 { toplam = toplam + i; }                 // 0+1+2+3+4 = 10
    for i in 0 .. 10 step 3 { toplam = toplam + i; }          // 0+3+6+9 = 18  -> 28
    for i in 0 .. 3 {
        for j in 0 .. 4 { toplam = toplam + 1; }              // 3*4 = 12      -> 40
    }
    int[4] d = [1, 2, 3, 4];
    for x in d { toplam = toplam + x * 10; }                  // 100           -> 140
    int k = 0;
    while k < 11 { k = k + 1; }                               // k = 11
    return toplam + k;
}
