// expect: 1
// output: 24
// output: once
// stderr: calisma zamani hatasi (satir 11): matris indeksi sinir disinda (indeks [1, 3, 0], boyut 2x3x4)
// Üç boyutta sınır denetimi: mesaj bütün indeksleri ve şekli gösterir.
func main() -> void {
    matrix<int, 3> a = ones(2, 3, 4);
    print(sum(a));
    int j = 3;
    print("once");
    print(a[1, j, 0]);
}
