// Test modülü (bkz. tests/modul_import.minik).
// Import yolu, import eden dosyanın dizinine göredir: tests/moduller/ic/yardimci.minik
import ic.yardimci as y;

float64 PI = 3.14159;       // private: yalnızca bu dosyada
public int cagri = 0;

public func kare(int x) -> int {
    return y.carp(x, x);
}

public func alan(float64 r) -> float64 {
    cagri = cagri + 1;
    return PI * r * r;
}

public func cagriSayisi() -> int {
    return cagri;
}

// Başka modüllerde de aynı adla fonksiyon var; çakışmamalı.
public func ad() -> int {
    return 1;
}

private func gizli() -> int {
    return 3;
}

// public fonksiyon kendi modülünün private fonksiyonunu çağırabilir.
public func gizliyiCagir() -> int {
    return gizli();
}
