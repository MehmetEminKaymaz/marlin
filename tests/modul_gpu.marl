// output: 6.0
// output: 27.0
import moduller.gpu_islem as gi;

@GPU
func islem(matrix<float64> a) -> matrix<float64> {
    matrix<float64> b = gi.olcekle(a, 3.0);     // @GPU → başka modüldeki @GPU
    parallel for i in 0 .. 3 {
        b[0, i] = gi.kare(b[0, i]);             // çekirdeğin içinden modül fonksiyonu
    }
    return b;
}

func main() -> void {
    matrix<float64> a = ones(1, 3);
    print(sum(gi.olcekle(a, 2.0)));             // @CPU → başka modüldeki @GPU
    print(sum(islem(a)));
}
