// expect: 59
func main() -> int {
    int s = 0;

    // Yalnızca continue: döngü scf.for kalır, gövde execute_region'a girer.
    for i in 0 .. 10 {
        if i % 2 == 1 { continue; }
        s = s + i;                      // 0+2+4+6+8 = 20
    }

    // break: döngü cf bloklarıyla üretilir.
    for i in 0 .. 100 {
        if i == 4 { break; }
        s = s + i;                      // 0+1+2+3 = 6      -> 26
    }

    // Yapısal for'un içinde break'li while: dış döngü scf.for kalır.
    for i in 0 .. 4 {
        int n = 0;
        while true {
            if n == 3 { break; }
            n = n + 1;
        }
        s = s + n;                      // 4*3 = 12         -> 38
    }

    // Aynı döngüde hem break hem continue.
    int k = 0;
    while k < 100 {
        k = k + 1;
        if k > 7 { break; }
        if k % 2 == 0 { continue; }
        s = s + k;                      // 1+3+5+7 = 16     -> 54
    }

    // Yalnızca continue içeren while.
    int m = 0;
    int c = 0;
    while m < 6 {
        m = m + 1;
        if m == 3 { continue; }
        c = c + 1;                      // c = 5
    }
    return s + c;
}
